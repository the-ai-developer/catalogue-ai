# ---- PostgreSQL ----
DATABASE_URL=postgres://catalogue:catalogue@localhost:5432/catalogue?sslmode=disable

# ---- Go API ----
HTTP_ADDR=:8080
MODEL_SERVER_URL=http://localhost:8090
ASSET_STORAGE_DIR=/data/assets
ASSET_PUBLIC_BASE_URL=/assets
MODEL_TIMEOUT_SHORT=5s
MODEL_TIMEOUT_LONG=30s
WORKER_POLL_INTERVAL=2s
LOG_LEVEL=info
# Bootstrap API keys (name:sha256hex:role) — DB `api_keys` table is authoritative;
# this is for first boot / local dev. Generate: sha256sum of a random secret.
# Default below = key "local-dev-admin-key" (used by scripts/ + tests/).
BOOTSTRAP_API_KEYS=local-admin:6f7593f48eb57fc679c0b173ee15f27ea20f32b92d146e414327218a079ab479:admin

# ---- Model server (Python) ----
MODEL_DEVICE=cuda            # cuda | cpu (cpu allowed for tests/dev)
TEXT_MODEL_NAME=sentence-transformers/all-mpnet-base-v2
IMAGE_MODEL_NAME=openai/clip-vit-base-patch32
DESC_MODEL_DIR=ml/checkpoints/t5-description   # HF T5 fine-tune output
PROJECTION_PATH=ml/checkpoints/projection/projection.pt
EMBED_DIM=512
FAISS_INDEX_DIR=/data/faiss
ASSET_ROOT=/data/assets
TEXT_INDEX_WEIGHT=0.6
IMAGE_INDEX_WEIGHT=0.4
CITATION_SUPPORT_THRESHOLD=0.35
MAX_CHUNK_TOKENS=220
CHUNK_OVERLAP_TOKENS=40

# ---- Web (Vite) ----
VITE_API_BASE=http://localhost:8080
