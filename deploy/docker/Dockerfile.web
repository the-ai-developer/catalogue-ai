# SolidJS web — static build behind nginx with SPA fallback.
FROM node:22-bookworm-slim AS build
WORKDIR /src
COPY web/package.json web/package-lock.json* ./
RUN npm install
COPY web/ .
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /src/dist /usr/share/nginx/html
COPY <<'EOF' /etc/nginx/conf.d/default.conf
server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;

  # SPA fallback
  location / {
    try_files $uri $uri/ /index.html;
  }

  # product-photo uploads served from the shared assets volume
  location /assets/ {
    alias /data/assets/;
  }
}
EOF
EXPOSE 80
